rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {

      allow read: if owner(userId) || admin();

      allow create: if owner(userId);

      allow update: if owner(userId) || admin();

      allow delete: if admin();
    }

    match /news/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /vehicles/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /characters/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /manufacturers/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /guides/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /subscribers/{emailId} {
      allow create, update: if
        request.resource.data.keys().hasOnly(["email", "createdAt"]) &&
        request.resource.data.email is string &&
        request.resource.data.email == emailId &&
        request.resource.data.email.matches("^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$") &&
        request.resource.data.createdAt == request.time;

      allow read, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}