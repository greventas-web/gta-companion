{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gta-companion\\.vercel\\.app"
        }
      ],
      "destination": "https://www.gta-companion.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^gta-companion\\.com$"
        }
      ],
      "destination": "https://www.gta-companion.com/:path*",
      "permanent": true
    }
  ]
}
